{
  "name": "fta-index",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "start:https": "ng serve -o --host localhost --ssl --ssl-key ./src/assets/local-ssl/server.key --ssl-cert ./src/assets/local-ssl/server.crt",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "s": "copy src\\config\\development.json src\\assets\\config\\config.json && ng s --port 4321 -c development",
    "s:s": "copy src\\config\\staging.json src\\assets\\config\\config.json && ng s --port 4321 -c staging",
    "s:p": "copy src\\config\\production.json src\\assets\\config\\config.json && ng s --port 4321 -c production",
    "b": "copy src\\config\\production.json src\\assets\\config\\config.json && ng b -c production",

    "sl": "cp src/config/development.json src/assets/config/config.json && ng s --port 4321 -c development",
    "sl:s": "cp src/config/staging.json src/assets/config/config.json && ng s --port 4321 -c staging",
    "sl:p": "cp src/config/production.json src/assets/config/config.json && ng s --port 4321 -c production",
    "bl": "cp src/config/production.json src/assets/config/config.json && ng b -c production"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~14.0.0",
    "@angular/cdk": "~14.0.0",
    "@angular/common": "~14.0.0",
    "@angular/compiler": "~14.0.0",
    "@angular/core": "~14.0.0",
    "@angular/fire": "^7.4.1",
    "@angular/forms": "~14.0.0",
    "@angular/platform-browser": "~14.0.0",
    "@angular/platform-browser-dynamic": "~14.0.0",
    "@angular/router": "~14.0.0",
    "@ng-idle/core": "^15.0.0",
    "@ng-stack/contenteditable": "^2.0.1",
    "@ngrx/effects": "^14.3.2",
    "@ngrx/entity": "^14.3.2",
    "@ngrx/store": "^14.3.2",
    "@ngx-translate/core": "^14.0.0",
    "@ngx-translate/http-loader": "^7.0.0",
    "angular-split": "^14.1.0",
    "chart.js": "^3.9.1",
    "custom-protocol-check": "^1.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^9.14.0",
    "json-stringify-safe": "^5.0.1",
    "jszip": "^3.10.1",
    "moment": "^2.29.4",
    "moment-timezone": "^0.5.43",
    "ngx-drag-drop": "^14.0.0",
    "pdfmake": "^0.2.13",
    "primeflex": "^3.2.0",
    "primeicons": "6.0.1",
    "primeng": "14.1.1",
    "prismjs": "^1.29.0",
    "quill": "^1.3.7",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "web-animations-js": "^2.3.2",
    "xlsx": "^0.18.5",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.2.11",
    "@angular/cli": "~14.0.3",
    "@angular/compiler-cli": "~14.0.0",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~3.10.0",
    "@types/jasminewd2": "~2.0.8",
    "@types/json-stringify-safe": "^5.0.0",
    "@types/node": "^12.11.1",
    "codelyzer": "^0.0.28",
